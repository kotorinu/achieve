{
  "name": "achieve (Laravel)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/achieve",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Laravel", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "php artisan serve --host=0.0.0.0 --port=8000",
  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "onecentlabs.laravel-blade",
        "EditorConfig.EditorConfig"
      ]
    }
  }
}
